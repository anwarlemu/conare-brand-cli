{
  "$comment": "How apply restyles an app: the role each color becomes, and for each kind of element the library item it takes its look from (recipes are the library components' own classes). Read by src/convert and src/apply; no brand values live in src/.",
  "roles": {
    "bg": {
      "neutral": [[0.995, "surface"], [0.94, "surface-subtle"], [0.86, "surface-sunken"], [0.55, "edge-strong"], [0.3, "fg-muted"], [0, "surface-inverse"]],
      "accent": [[0.86, "surface-subtle"], [0.7, "surface-sunken"], [0, "action-primary"]],
      "danger": [[0.86, "surface-danger"], [0, "action-danger"]],
      "success": [[0.86, "surface-subtle"], [0, "status-working"]],
      "warning": [[0.86, "surface-subtle"], [0, "status-working"]]
    },
    "text": {
      "neutral": [[0.95, "fg-inverse"], [0.75, "fg-inverse/70"], [0.55, "fg-faint"], [0.4, "fg-muted"], [0.22, "fg-soft"], [0, "fg"]],
      "accent": [[0.75, "fg-inverse"], [0.55, "fg-accent-display"], [0, "fg-accent"]],
      "danger": [[0.75, "fg-inverse"], [0.55, "fg-accent-display"], [0, "fg-danger"]],
      "success": [[0.75, "fg-inverse"], [0, "fg-soft"]],
      "warning": [[0.75, "fg-inverse"], [0, "fg-soft"]]
    },
    "border": {
      "neutral": [[0.88, "edge"], [0.6, "edge-strong"], [0.4, "fg-faint"], [0, "fg-soft"]],
      "accent": [[0.8, "edge"], [0, "edge-focus"]],
      "danger": [[0.8, "edge"], [0, "edge-accent"]],
      "success": [[0.8, "edge"], [0, "edge-strong"]],
      "warning": [[0.8, "edge"], [0, "edge-strong"]]
    },
    "hover": {
      "accent": "action-primary-hover",
      "danger": "action-danger-hover"
    }
  },
  "text": {
    "steps": { "caption": 11, "meta": 12, "ui": 13, "body": 14, "body-lg": 15, "card-title": 18, "heading-3": 20, "heading-2": 24, "heading-1": 32, "hero": 40, "display": 48 },
    "tailwind": { "xs": 12, "sm": 14, "base": 16, "lg": 18, "xl": 20, "2xl": 24, "3xl": 30, "4xl": 36, "5xl": 48, "6xl": 60, "7xl": 72, "8xl": 96, "9xl": 128 },
    "base": "body-lg",
    "headings": { "display": 44, "hero": 36, "heading-1": 28, "heading-2": 22, "heading-3": 19, "heading-4": 0 }
  },
  "fonts": { "text": "--ds-font-text", "heading": "--ds-font-heading", "code": "--ds-font-code" },
  "variables": {
    "$comment": "shadcn and shadcn-vue theme variables, pointed at the brand's roles (the dark block takes each role's dark value).",
    "background": "surface", "foreground": "fg",
    "card": "surface", "card-foreground": "fg",
    "popover": "surface", "popover-foreground": "fg",
    "primary": "action-primary", "primary-foreground": "action-primary-fg",
    "secondary": "surface-subtle", "secondary-foreground": "fg",
    "muted": "surface-subtle", "muted-foreground": "fg-muted",
    "accent": "surface-subtle", "accent-foreground": "fg",
    "destructive": "action-danger", "destructive-foreground": "fg-on-accent",
    "border": "edge", "input": "edge-strong", "ring": "edge-focus",
    "chart-1": "data-1", "chart-2": "data-2", "chart-3": "data-3", "chart-4": "fg", "chart-5": "fg-soft",
    "sidebar": "surface-subtle", "sidebar-foreground": "fg",
    "sidebar-primary": "action-primary", "sidebar-primary-foreground": "action-primary-fg",
    "sidebar-accent": "surface-sunken", "sidebar-accent-foreground": "fg",
    "sidebar-border": "edge", "sidebar-ring": "edge-focus",
    "radius": "--ds-radius-control"
  },
  "aliases": {
    "badge": "tag", "chip": "tag", "pill": "tag", "modal": "dialog", "dropdown": "menu", "dropdown-menu": "menu",
    "spinner": "loader", "sonner": "toast", "progress": "meter", "empty": "empty-state", "input": "field",
    "text-field": "field", "textfield": "field", "select": "scope-menu", "combobox": "scope-menu", "breadcrumb": "top-bar",
    "navigation-menu": "product-menu", "command": "command-palette", "input-group": "search-box", "panel": "card",
    "banner": "alert", "callout": "alert", "heading": "typography", "headings": "typography", "btn": "button"
  },
  "kinds": {
    "button": {
      "item": "button",
      "names": "^(base|app|ui|the|primary|secondary|ghost|danger|icon|action|submit|my|v)?-?(button|btn)$",
      "replace": ["bg", "text-color", "border-color", "border-width", "radius", "shadow", "ring", "outline", "padding", "height", "type", "motion", "state"],
      "base": "cursor-pointer border h-control-sm px-2.5 text-meta leading-5 font-medium rounded-control transition-[color,background-color,border-color] duration-120 ease-standard disabled:cursor-not-allowed disabled:border-edge disabled:bg-surface-sunken disabled:text-fg-soft max-md:h-control-touch max-md:text-ui pointer-coarse:h-control-touch pointer-coarse:text-ui",
      "icon": "w-control-sm px-0 max-md:w-control-touch pointer-coarse:w-control-touch",
      "variants": {
        "secondary": "border-action-secondary-edge bg-surface text-fg hover:enabled:border-action-secondary-edge-hover active:enabled:bg-surface-subtle",
        "dark": "border-action-primary bg-action-primary text-action-primary-fg hover:enabled:border-edge-accent hover:enabled:bg-edge-accent",
        "primary": "border-edge-accent bg-edge-accent text-off-white hover:enabled:border-home-red-hover hover:enabled:bg-home-red-hover active:enabled:border-home-red-press active:enabled:bg-home-red-press",
        "ghost": "border-transparent bg-transparent text-fg-soft hover:enabled:border-edge hover:enabled:text-fg active:enabled:bg-surface-subtle",
        "danger": "border-action-danger bg-surface text-action-danger hover:enabled:bg-action-danger-hover hover:enabled:text-off-white"
      },
      "keys": {
        "dark": ["default", "primary", "solid", "dark", "filled", "cta", "main"],
        "danger": ["destructive", "danger", "error", "delete", "remove", "negative"],
        "secondary": ["outline", "outlined", "secondary", "bordered", "neutral", "white", "light", "soft"],
        "ghost": ["ghost", "subtle", "text", "plain", "minimal", "tertiary", "quiet", "flat"]
      },
      "default": "secondary"
    },
    "input": {
      "item": "field",
      "names": "^(base|app|ui|the|text|form|my|v)?-?(input|text-?field|text-?input)$",
      "replace": ["bg", "text-color", "border-color", "border-width", "radius", "shadow", "ring", "outline", "padding", "height", "type", "motion", "placeholder"],
      "base": "h-control-md border border-edge-strong bg-surface px-2.5 text-ui text-fg rounded-control outline-none transition-[border-color] duration-120 ease-standard placeholder:text-fg-muted focus:border-edge-focus aria-invalid:border-action-danger disabled:cursor-not-allowed disabled:text-fg-muted max-md:h-control-touch max-md:text-input pointer-coarse:h-control-touch pointer-coarse:text-input"
    },
    "textarea": {
      "item": "textarea",
      "names": "^(base|app|ui|the|form|my|v)?-?(textarea|text-?area)$",
      "replace": ["bg", "text-color", "border-color", "border-width", "radius", "shadow", "ring", "outline", "padding", "type", "motion", "placeholder"],
      "base": "border border-edge-strong bg-surface px-3 py-1.5 text-ui text-fg rounded-control outline-none transition-[border-color] duration-200 ease-standard placeholder:text-fg-muted focus:border-edge-focus aria-invalid:border-action-danger disabled:cursor-not-allowed disabled:border-edge disabled:text-fg-muted max-md:text-input"
    },
    "select": {
      "item": "native-select",
      "names": "^(base|app|ui|the|form|native|my|v)?-?(select|dropdown-?select)$",
      "replace": ["bg", "text-color", "border-color", "border-width", "radius", "shadow", "ring", "outline", "padding", "height", "type", "motion"],
      "base": "h-control-md cursor-pointer border border-edge-strong bg-surface px-2.5 text-ui text-fg rounded-control outline-none transition-[border-color] duration-200 ease-standard focus:border-edge-focus disabled:cursor-not-allowed disabled:border-edge disabled:text-fg-muted max-md:h-control-touch max-md:text-input"
    },
    "checkbox": {
      "item": "checkbox",
      "names": "^(base|app|ui|the|form|my|v)?-?(checkbox|check-?box|radio)$",
      "replace": ["bg", "text-color", "border-color", "radius", "shadow", "ring", "accent"],
      "base": "cursor-pointer rounded-control accent-fg"
    },
    "card": {
      "item": "card",
      "names": "^(base|app|ui|the|my|v|info|stat|feature|pricing|product|plan)?-?(card|panel|tile)$",
      "replace": ["bg", "border-color", "border-width", "radius", "shadow", "ring"],
      "base": "border border-edge bg-surface rounded-container"
    },
    "dialog": {
      "item": "dialog",
      "names": "^(base|app|ui|the|my|v|confirm)?-?(dialog|modal)$",
      "replace": ["bg", "border-color", "border-width", "radius", "shadow", "ring"],
      "base": "border border-edge bg-surface text-fg rounded-container",
      "backdrop": "bg-scrim"
    },
    "badge": {
      "item": "tag",
      "names": "^(base|app|ui|the|status|my|v)?-?(badge|tag|chip|pill)$",
      "replace": ["bg", "text-color", "border-color", "border-width", "radius", "shadow", "ring", "padding", "height", "type"],
      "base": "h-4.5 border px-1.25 pb-0.5 text-caption leading-4 font-normal rounded-control",
      "variants": {
        "default": "border-edge text-fg",
        "working": "border-status-working bg-status-working text-status-working-fg",
        "failed": "border-transparent bg-status-failed text-status-failed-fg",
        "quiet": "border-edge text-fg-muted"
      },
      "default": "default"
    },
    "table": {
      "item": "table",
      "names": "^(base|app|ui|the|data|my|v)?-?(table|data-?table|grid)$",
      "replace": ["type"],
      "base": "border-collapse text-ui",
      "th": { "replace": ["bg", "text-color", "border-color", "border-width", "padding", "height", "type"], "base": "h-control-md border-b border-edge bg-surface-subtle px-3 text-meta font-normal text-fg-muted" },
      "td": { "replace": ["border-color", "border-width", "padding", "height", "type"], "base": "h-row border-b border-edge px-3 py-1 text-ui" }
    },
    "tabs": {
      "item": "tabs",
      "names": "^(base|app|ui|the|my|v)?-?(tabs|tab-?bar|segmented(-?control)?)$",
      "replace": ["bg", "border-color", "border-width", "radius", "shadow", "padding"],
      "base": "border border-edge bg-surface-subtle p-0.5 rounded-control",
      "tab": { "replace": ["bg", "text-color", "border-color", "border-width", "radius", "shadow", "padding", "height", "type", "motion"], "base": "h-control-xs px-2 text-meta text-fg-muted rounded-control transition-[color,background-color] duration-160 ease-standard hover:text-fg aria-selected:bg-surface aria-selected:text-fg aria-selected:outline aria-selected:outline-edge" }
    },
    "link": {
      "item": "link",
      "names": "^(base|app|ui|the|text|my|v)?-?(link|anchor)$",
      "replace": ["text-color", "decoration", "motion"],
      "base": "text-fg underline decoration-edge-strong underline-offset-4 transition-[text-decoration-color] duration-200 ease-standard hover:decoration-fg"
    },
    "label": {
      "item": "label",
      "names": "^(base|app|ui|the|form|field|my|v)?-?label$",
      "replace": ["text-color", "type"],
      "base": "text-meta text-fg-soft"
    },
    "alert": {
      "item": "alert",
      "names": "^(base|app|ui|the|my|v)?-?(alert|banner|callout|notice)$",
      "replace": ["bg", "border-color", "border-width", "radius", "shadow", "ring"],
      "base": "border border-edge bg-surface-subtle rounded-container",
      "variants": {
        "default": "border-edge bg-surface-subtle",
        "danger": "border-home-red-press bg-surface-danger text-fg-danger"
      },
      "default": "default"
    },
    "typography": {
      "item": "typography",
      "names": "^(base|app|ui|the|my|v|page|section)?-?(heading|title|headline)$",
      "replace": ["type"],
      "base": ""
    }
  }
}
