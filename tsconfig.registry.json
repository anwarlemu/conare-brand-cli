{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": { "@/*": ["registry/*"] }
  },
  "vueCompilerOptions": { "strictTemplates": false },
  "include": ["registry/**/*.ts", "registry/**/*.vue"],
  "exclude": ["registry/react", "registry/elements"]
}
